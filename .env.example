# Cadena de conexión de Neon (Dashboard → Connect → "Pooled connection")
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clave para firmar la sesión. Generar con: openssl rand -base64 32
SESSION_SECRET=

# API de Claude, para leer los tickets (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Opcional: otro modelo para la lectura (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=

# Vercel Blob (privado) para las fotos. Sin esto, en local se guardan en .uploads/
# BLOB_READ_WRITE_TOKEN=
